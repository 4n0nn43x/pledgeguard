-- End-to-end scenario plus the privacy assertions the demo shows on screen.
-- The stablecoin leg is a mock implementing the token-standard Allocation interface
-- (on DevNet it is an Amulet / USDCx allocation, same interface, same controllers).
module PledgeGuard.Test.Scenario where

import DA.Assert ((===))
import DA.Date (Month(..), date)
import DA.Optional (isNone)
import DA.Time (time)
import Daml.Script
import Splice.Api.Token.AllocationV1
import Splice.Api.Token.HoldingV1 (InstrumentId(..))
import Splice.Api.Token.MetadataV1 (emptyMetadata)
import PledgeGuard.Lending
import PledgeGuard.Registry

-- | Stand-in for an Amulet/USDCx allocation. Executing it leaves a MockTransfer behind,
-- which is what the test checks to know whether money moved.
template MockAllocation
  with
    executor : Party
    sender : Party
    receiver : Party
    amount : Decimal
  where
    signatory sender
    observer executor, receiver

    interface instance Allocation for MockAllocation where
      view = AllocationView with
        allocation = AllocationSpecification with
          settlement = SettlementInfo with
            executor
            settlementRef = Reference with id = "draw", cid = None
            requestedAt = t0
            allocateBefore = t0
            settleBefore = t0
            meta = emptyMetadata
          transferLegId = "draw"
          transferLeg = TransferLeg with
            sender
            receiver
            amount
            instrumentId = InstrumentId with admin = executor, id = "MOCK"
            meta = emptyMetadata
        holdingCids = []
        meta = emptyMetadata
      allocation_executeTransferImpl _ _ = do
        create MockTransfer with sender, receiver, amount
        pure Allocation_ExecuteTransferResult with
          senderHoldingCids = [], receiverHoldingCids = [], meta = emptyMetadata
      allocation_cancelImpl _ _ =
        pure Allocation_CancelResult with senderHoldingCids = [], meta = emptyMetadata
      allocation_withdrawImpl _ _ =
        pure Allocation_WithdrawResult with senderHoldingCids = [], meta = emptyMetadata

template MockTransfer
  with
    sender : Party
    receiver : Party
    amount : Decimal
  where
    signatory sender
    observer receiver

t0 : Time
t0 = time (date 2026 Oct 1) 0 0 0

hashX : Text
hashX = "9f2c1e4b7a6d8c3f5e0b2a1d4c7e9f8b6a5d3c2e1f0a9b8c7d6e5f4a3b2c1d0e"

-- | Happy path, collision, release, retry. Every step ends with what each party can see.
scenario : Script ()
scenario = do
  originator <- allocateParty "Originator"
  lenderA <- allocateParty "LenderA"
  lenderB <- allocateParty "LenderB"
  registry <- allocateParty "Registry"
  auditor <- allocateParty "Auditor"
  setTime t0

  -- 1. Fingerprint registered, registry opens the per-hash index.
  fp <- submit originator do
    createCmd CollateralFingerprint with originator, registry, schemaId = "receivables-pool-v1", hash = hashX
  idx0 <- submit registry do exerciseCmd fp CollateralFingerprint_Index

  -- 2. Two facilities on the same collateral, each strictly bilateral.
  let propose lender amount rate = do
        p <- submit lender do
          createCmd FacilityProposal with
            lender, originator, registry, schemaId = "receivables-pool-v1", hash = hashX
            amount, rate, maturity = time (date 2027 Apr 1) 0 0 0
        submit originator do exerciseCmd p FacilityProposal_Accept
  facA <- propose lenderA 1_000_000.0 0.085
  facB <- propose lenderB 750_000.0 0.091

  -- 3. Lender A draws: allocation, request, registry settles atomically.
  allocA <- submit lenderA do
    createCmd MockAllocation with executor = registry, sender = lenderA, receiver = originator, amount = 1_000_000.0
  reqA <- submit lenderA do
    exerciseCmd facA Facility_RequestDraw with allocationCid = toInterfaceContractId allocA
  resA <- submit registry do exerciseCmd reqA DrawRequest_Settle with indexCid = idx0, auditor
  claimA <- case resA of
    Settled c -> pure c
    Collided _ -> fail "first draw must settle"
  transfersA <- query @MockTransfer originator
  map (\(_, t) -> t.amount) transfersA === [1_000_000.0]

  -- Privacy after the first draw: B and the registry see nothing of A's facility.
  b_seesFacA <- queryContractId lenderB facA
  assertMsg "lender B must not see facility A" (isNone b_seesFacA)
  regFacilities <- query @Facility registry
  regFacilities === []
  b_claims <- query @Claim lenderB
  b_claims === []
  [(idx1, idxA)] <- query @ClaimIndex registry
  idxA.holder === Some lenderA

  -- 4. Lender B tries the same hash: no transfer, one notice per lender, auditor sees both.
  allocB <- submit lenderB do
    createCmd MockAllocation with executor = registry, sender = lenderB, receiver = originator, amount = 750_000.0
  reqB <- submit lenderB do
    exerciseCmd facB Facility_RequestDraw with allocationCid = toInterfaceContractId allocB
  resB <- submit registry do exerciseCmd reqB DrawRequest_Settle with indexCid = idx1, auditor
  case resB of
    Collided _ -> pure ()
    Settled _ -> fail "second draw on the same hash must collide"
  transfersAfterB <- query @MockTransfer originator
  length transfersAfterB === 1
  nA <- query @CollisionNotice lenderA
  map (\(_, n) -> n.recipient) nA === [lenderA]
  nB <- query @CollisionNotice lenderB
  map (\(_, n) -> n.recipient) nB === [lenderB]
  nAud <- query @CollisionNotice auditor
  length nAud === 2
  nOrig <- query @CollisionNotice originator
  nOrig === []
  audFacilities <- query @Facility auditor
  audFacilities === []

  -- 5. The registry cannot settle against an index for another hash.
  fpY <- submit originator do
    createCmd CollateralFingerprint with originator, registry, schemaId = "receivables-pool-v1", hash = "other"
  idxY <- submit registry do exerciseCmd fpY CollateralFingerprint_Index
  reqB2 <- submit lenderB do
    exerciseCmd facB Facility_RequestDraw with allocationCid = toInterfaceContractId allocB
  submitMustFail registry do exerciseCmd reqB2 DrawRequest_Settle with indexCid = idxY, auditor

  -- 6. A repays and releases; B's retry now settles.
  idx2 <- submit lenderA do exerciseCmd claimA Claim_Release
  resB2 <- submit registry do exerciseCmd reqB2 DrawRequest_Settle with indexCid = idx2, auditor
  case resB2 of
    Settled _ -> pure ()
    Collided _ -> fail "draw after release must settle"
  transfersFinal <- query @MockTransfer originator
  length transfersFinal === 2
  pure ()
